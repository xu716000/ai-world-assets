  "guidelines": {
    "outline": {
      "width": 2,
      "style": "neon",
      "description": "所有资源必须有2像素的霓虹描边"
    },
    "shadow": {
      "style": "hard",
      "angle": 225,
      "description": "硬阴影，左上45°光源"
    },
    "lighting": {
      "angle_degrees": 45,
      "direction": "top-left",
      "intensity": "high_contrast"
    },
    "restrictions": [
      "禁止渐变效果（只用色块）",
      "禁止文字和水印",
      "禁止软边阴影（只用硬阴影）",
      "禁止半透明过渡",
      "禁止复杂细节"
    ]
  },
  
  "palette_exports": {
    "description": "可直接导入到绘图软件的调色板",
